<resources>
    <style name="Theme.ChatYUE" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/ds_blue</item>
        <item name="colorPrimaryDark">@color/ds_blue_dark</item>
        <item name="colorAccent">@color/ds_blue</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ds_surface</item>
        <item name="android:colorAccent">@color/ds_blue</item>
        <item name="android:statusBarColor">@color/ds_blue_dark</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.ChatYUE.DrawerToolRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Widget.ChatYUE.DrawerToolLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.ChatYUE.ToolHeaderTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ChatYUE.GroupHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ChatYUE.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.ChatYUE.SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.ChatYUE.Tool" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/ds_blue</item>
        <item name="colorPrimaryDark">@color/ds_blue_dark</item>
        <item name="colorAccent">@color/ds_blue</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/ds_surface</item>
        <item name="android:colorAccent">@color/ds_blue</item>
        <item name="android:statusBarColor">@color/ds_surface</item>
        <item name="android:navigationBarColor">@color/ds_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>
    <!-- 启动画面（2.0）：纯白全屏、无标题栏 -->
    <style name="Theme.ChatYUE.Splash" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">@color/ds_blue</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>

    <!-- OOBE 引导（2.0）：背景由自定义 View 绘制，状态栏透明让渐变延伸 -->
    <style name="Theme.ChatYUE.Oobe" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">@color/ds_blue</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
