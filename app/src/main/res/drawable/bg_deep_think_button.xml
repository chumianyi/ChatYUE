<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_blue_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ds_blue" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/ds_divider" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
