<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_context_warning_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ds_context_warning" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ds_divider" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
