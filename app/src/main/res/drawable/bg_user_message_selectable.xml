<?xml version="1.0" encoding="utf-8"?>
<!-- 用户消息气泡：多选选中时描蓝边浅蓝底，未选中保持原浅蓝底。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_blue_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/ds_blue" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_user_message" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</selector>
