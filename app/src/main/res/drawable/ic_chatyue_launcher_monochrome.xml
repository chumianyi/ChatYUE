<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ 主题图标使用的单色剪影：居中的圆形（对应图标里的球体）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="32dp"
        android:left="32dp"
        android:right="32dp"
        android:top="32dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
