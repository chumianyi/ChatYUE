<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:fitsSystemWindows="false"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_surface"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_history"
                android:padding="13dp"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/chatTitle"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:gravity="center"
                android:maxWidth="150dp"
                android:maxLines="1"
                android:text="@string/new_chat"
                android:textColor="@color/ds_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/contextPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_context_chip"
                    android:contentDescription="@string/context_usage_title"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/context_usage_zero"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/newChatButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/create_new_chat"
                    android:padding="13dp"
                    android:src="@drawable/ic_new_chat" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/welcomeContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <ImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chatyue_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/welcome_title"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/welcome_subtitle"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messageList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp"
                android:scrollbars="none"
                android:visibility="gone"
                tools:listitem="@layout/item_message_assistant" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_composer"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="5dp">

                <LinearLayout
                    android:id="@+id/attachmentBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="2dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/attachmentThumb"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_card"
                        android:contentDescription="@string/attachment_image_label"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/attachmentName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="12sp"
                        tools:text="IMG_0001.jpg" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/attachmentRemove"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/attach_remove"
                        android:padding="9dp"
                        android:src="@drawable/ic_close" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp">

                    <com.chatyue.chat.CompatPasteEditText
                        android:id="@+id/messageInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="@string/message_hint"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="5"
                        android:minHeight="48dp"
                        android:paddingStart="10dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="52dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/ds_text_primary"
                        android:textColorHint="@color/ds_text_tertiary"
                        android:textSize="15sp" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/sendButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="5dp"
                        android:background="@drawable/bg_send_button"
                        android:contentDescription="@string/send_message"
                        android:enabled="false"
                        android:padding="8dp"
                        android:src="@drawable/ic_send" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/addButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/add_attachment"
                        android:padding="7dp"
                        android:src="@drawable/ic_add" />

                    <TextView
                        android:id="@+id/thinkingModeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_deep_think_button"
                        android:clickable="false"
                        android:contentDescription="@string/thinking_mode_fixed"
                        android:drawableStart="@drawable/ic_deep_think"
                        android:drawablePadding="6dp"
                        android:focusable="false"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/thinking_mode_label"
                        android:textColor="@color/deep_think_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawerContent"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/ds_surface"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:text="@string/tools_title"
            android:textColor="@color/ds_text_tertiary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/toolTranslate"
            style="@style/Widget.ChatYUE.DrawerToolRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tool_translate" />

            <TextView
                style="@style/Widget.ChatYUE.DrawerToolLabel"
                android:text="@string/tool_translate" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolEssay"
            style="@style/Widget.ChatYUE.DrawerToolRow">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tool_essay" />

            <TextView
                style="@style/Widget.ChatYUE.DrawerToolLabel"
                android:text="@string/tool_essay" />
        </LinearLayout>



        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/ds_divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_search_field">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="11dp"
                android:src="@drawable/ic_search" />

            <com.chatyue.chat.CompatPasteEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/search_conversations"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="44dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ds_text_primary"
                android:textColorHint="@color/ds_text_tertiary"
                android:textSize="15sp" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/conversationList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:scrollbars="none"
            tools:listitem="@layout/item_conversation" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ds_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_logo_circle"
                android:padding="5dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chatyue_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/account_name"
                android:textColor="@color/ds_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/moreButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:padding="12dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
