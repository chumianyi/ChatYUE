<?xml version="1.0" encoding="utf-8"?>
<!--
  ChatYUE 2.0 启动画面。
  结构：纯白底 + 抠图后的官方形象（视觉主体）+ 下方「AI 图标 + 双层文字」。
  文字层级固定：上层 ChatYUE，下层「给你更好的体验」，小号字居中对齐于主文字正下方。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="56dp"
        android:paddingBottom="72dp">

        <!-- 视觉主体：经过精准抠图的二次元官方形象，边缘干净、独立展示于纯白之上 -->
        <ImageView
            android:id="@+id/splashMascot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_mascot" />

        <!-- 双层文字 + 左侧固定放置的官方 AI 图标 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chatyue_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.02"
                    android:text="@string/splash_title"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/splash_subtitle"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
