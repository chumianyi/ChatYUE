<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/assistantLogo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_logo_circle"
        android:padding="3dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/ic_chatyue_logo" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include
            layout="@layout/view_reply_quote"
            android:layout_width="match_parent"
            android:layout_marginBottom="6dp"
            xmlns:tools="http://schemas.android.com/tools"
            tools:visibility="visible" />

        <com.chatyue.chat.CompatSelectableTextView
            android:id="@+id/messageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/messageActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/copyButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_copy"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_action_copy" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/likeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_like"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_action_like" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/dislikeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_dislike"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_action_dislike" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
