<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_code_preview"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/modeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/languageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_blue"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="HTML" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/modePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/code_preview_mode_preview"
            android:textColor="@color/ds_text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/modeCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/code_preview_mode_code"
            android:textColor="@color/ds_text_primary"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/copyButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/code_preview_copy"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_action_copy" />

        <ImageButton
            android:id="@+id/downloadButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/code_preview_download"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_download" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <WebView
            android:id="@+id/previewWebView"
            android:layout_width="match_parent"
            android:layout_height="220dp" />

        <TextView
            android:id="@+id/previewMarkdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_text_primary"
            android:textSize="14sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/codeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/codeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_code_block"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="@color/ds_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/hiddenHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:textColor="@color/ds_text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
