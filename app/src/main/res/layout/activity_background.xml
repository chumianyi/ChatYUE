<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_surface"
    android:fillViewport="true"
    tools:context=".BackgroundActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/navigate_back"
                android:padding="13dp"
                android:src="@drawable/ic_back" />

            <TextView
                style="@style/Widget.ChatYUE.ToolHeaderTitle"
                android:text="@string/background_title" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/ds_divider" />

        <!-- 预览 -->
        <TextView
            style="@style/Widget.ChatYUE.GroupHeader"
            android:text="@string/background_preview" />

        <FrameLayout
            android:id="@+id/backgroundPreview"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/white" />

        <!-- 浅色预设 -->
        <TextView
            style="@style/Widget.ChatYUE.GroupHeader"
            android:text="@string/background_preset_section" />

        <GridLayout
            android:id="@+id/presetGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:columnCount="4" />

        <!-- 自定义图片 -->
        <TextView
            style="@style/Widget.ChatYUE.GroupHeader"
            android:text="@string/background_image_section" />

        <LinearLayout
            android:id="@+id/pickImageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/background_pick_image"
                android:textColor="@color/ds_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/removeImageRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/background_remove_image"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/imageState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:textColor="@color/ds_text_tertiary"
            android:textSize="12sp"
            tools:text="尚未选择图片" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:text="@string/background_note"
            android:textColor="@color/ds_text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
