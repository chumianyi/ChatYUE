<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      背景层直接使用整张图标（缩放到 108dp 铺满），系统只取中间 72dp，
      正好保留深蓝渐变底色与居中的球体，并自然裁掉四周圆角。
    -->
    <background android:drawable="@mipmap/ic_chatyue_launcher_background" />
    <!-- 前景层留空，图形全部由背景层承载 -->
    <foreground android:drawable="@drawable/ic_chatyue_launcher_foreground" />
    <!-- Android 13+ 主题图标：使用居中圆形的单色剪影 -->
    <monochrome android:drawable="@drawable/ic_chatyue_launcher_monochrome" />
</adaptive-icon>
