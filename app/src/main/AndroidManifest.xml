<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 选择相册图片需要读取设备中的图片（Android 13+ 使用细分权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 旧系统（API 28 及以下）导出数据、写入公共图片目录需要写权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_chatyue_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_chatyue_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChatYUE"
        android:usesCleartextTraffic="true"
        tools:targetApi="24">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ChatYUE.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".OobeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ChatYUE.Oobe" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".BackgroundActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".DataManagerActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AgreementActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".ChangelogActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".attachment.ImageGalleryActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".MessageSearchActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".license.LicenseActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".license.LicenseDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool" />

        <activity
            android:name=".tools.TranslationActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".tools.EssayActivity"
            android:exported="false"
            android:theme="@style/Theme.ChatYUE.Tool"
            android:windowSoftInputMode="adjustResize" />


    </application>

</manifest>
